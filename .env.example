# Copy to .env and fill in. NEVER commit .env.
PKA_ENVIRONMENT=local                  # local | test | production
PKA_DATABASE_URL=postgresql+psycopg://pka:pka@localhost:5432/pka
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PKA_SECRET_KEY=
# JSON list. Never "*" in production.
PKA_ALLOWED_ORIGINS=["http://localhost:8501"]
PKA_LOG_LEVEL=INFO
PKA_DEV_AUTH_ENABLED=true
PKA_EMBEDDING_BACKEND=none